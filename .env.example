# MANAK-AI Environment Configuration
APP_MODE=demo
PROJECT_NAME="MANAK-AI"
VERSION="1.0.0"

# AI / Vision Providers (Optional for demo mode; required for live production Gemini)
GEMINI_API_KEY=

# Database (defaults to embedded SQLite aiosqlite for single-click zero-config local run)
